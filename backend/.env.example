# ================================
# 灵枢运维平台 - 环境变量配置模板
# ================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填写实际的配置值
# 3. 不要将 .env 文件提交到Git
# ================================

# 服务器配置
SERVER_PORT=9003

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=linshu_db
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# 邮件配置（用于告警通知）
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_smtp_authorization_code
MAIL_FROM=your_email@qq.com

# AI配置（百度千帆）
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
QIANFAN_TOKEN=your_qianfan_api_token
QIANFAN_MODEL=glm-5
QIANFAN_TIMEOUT=120
QIANFAN_AGENT_TIMEOUT=30

# JWT配置
# 生成命令: openssl rand -base64 64
JWT_SECRET=changeme-please-use-a-very-long-random-string-at-least-256-bits
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_COOKIE_NAME=linshu_token

# 加密配置
# 生成命令: openssl rand -base64 32
ENCRYPTION_KEY=changeme-use-openssl-rand-base64-32

# 监控配置
MONITOR_INTERVAL=30000
ALERT_INTERVAL=120000
ALERT_LOOKBACK=20
MAIL_COOLDOWN=30

# 日志配置
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
LOG_FILE=logs/linshu-ops.log

# MyBatis日志（开发环境用StdOutImpl，生产用NoLoggingImpl）
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.stdout.StdOutImpl
